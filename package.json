{
  "name": "reinos-da-aurora",
  "version": "0.4.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "build:sites": "npm run build && node scripts/hosting.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser.mjs",
    "test:archer": "node tests/archer-browser.mjs",
    "test:strike": "node tests/strike-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:admin": "node tests/admin-browser.mjs",
    "test:portrait": "node tests/portrait-browser.mjs",
    "test:offline": "node tests/offline-browser.mjs",
    "build:portable": "tsc --noEmit && vite build --mode portable && node scripts/portable.mjs",
    "start": "node server/start.mjs",
    "test:world": "node tests/world-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
